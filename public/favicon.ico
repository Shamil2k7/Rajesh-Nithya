<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stopColor="#6E0E0E" />
      <stop offset="50%" stopColor="#570A0A" />
      <stop offset="100%" stopColor="#2A0303" />
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stopColor="#FFF4D4" />
      <stop offset="35%" stopColor="#F4D77A" />
      <stop offset="70%" stopColor="#D4A843" />
      <stop offset="100%" stopColor="#9E701C" />
    </linearGradient>
    <filter id="goldGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="1" stdDeviation="1" floodColor="#F4D77A" floodOpacity="0.4" />
    </filter>
  </defs>

  <!-- Deep Maroon Rounded Background -->
  <rect width="64" height="64" rx="16" fill="url(#bgGrad)" />

  <!-- Outer Double Gold Border -->
  <rect x="2.5" y="2.5" width="59" height="59" rx="14" fill="none" stroke="url(#goldGrad)" stroke-width="1.8" />
  <rect x="5.5" y="5.5" width="53" height="53" rx="11" fill="none" stroke="url(#goldGrad)" stroke-width="0.8" opacity="0.6" stroke-dasharray="2 2" />

  <!-- Corner Accent Dots -->
  <circle cx="8" cy="8" r="1.5" fill="url(#goldGrad)" />
  <circle cx="56" cy="8" r="1.5" fill="url(#goldGrad)" />
  <circle cx="8" cy="56" r="1.5" fill="url(#goldGrad)" />
  <circle cx="56" cy="56" r="1.5" fill="url(#goldGrad)" />

  <!-- Top Center Auspicious Sparkle / Star -->
  <g transform="translate(32, 10.5)" filter="url(#goldGlow)">
    <path d="M 0 -3.5 L 1 -1 L 3.5 0 L 1 1 L 0 3.5 L -1 1 L -3.5 0 L -1 -1 Z" fill="url(#goldGrad)" />
  </g>

  <!-- Monogram R & N -->
  <g filter="url(#goldGlow)">
    <!-- R & N in elegant royal serif typography -->
    <text
      x="32"
      y="42"
      text-anchor="middle"
      font-family="'Cormorant Garamond', Georgia, serif"
      font-size="25"
      font-weight="700"
      letter-spacing="1"
      fill="url(#goldGrad)"
    >R&amp;N</text>
  </g>

  <!-- Subtle bottom decorative curve -->
  <path d="M 22 49 Q 32 52 42 49" fill="none" stroke="url(#goldGrad)" stroke-width="1" stroke-linecap="round" opacity="0.8" />
  <circle cx="32" cy="50.8" r="1.2" fill="url(#goldGrad)" />
</svg>
